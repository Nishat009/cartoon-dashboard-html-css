# First port to try; if it is busy the API moves to the next free one.
PORT=3000
# Local Docker MongoDB (npm run db:up):
MONGODB_URI=mongodb://127.0.0.1:27017/cartoon_lifestyle
# MongoDB Atlas (keep the /cartoon_lifestyle database name before the "?"):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/cartoon_lifestyle?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-this-with-a-long-random-secret
# Optional: comma-separated origins allowed to call the API. Leave unset to allow
# any http://localhost port.
# CLIENT_ORIGIN=https://your-site.example
# Optional: DNS servers Node uses for mongodb+srv:// lookups. Set this if
# connecting to Atlas fails with "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,1.1.1.1
